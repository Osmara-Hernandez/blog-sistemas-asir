
---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Proyecto | Blog de Sistemas">

  <h1>Proyecto</h1>

  <section class="bloque">

    <p>
      Introducción
    </p>

    <p>
      Añadir descripción
    </p>

  </section>

  <section class="bloque">

    <h2>Tecnologías utilizadas</h2>

    <ul>
      <li>Astro</li>
      <li>JavaScript</li>
      <li>Git y GitHub</li>
      <li>Ubuntu</li>
      <li>XAMPP</li>
      <li>MariaDB</li>
    </ul>

  </section>

  <section class="bloque">

    <h2>Objetivos principales</h2>

    <ul>
      <li>Construir una web con varias páginas</li>
      <li>Publicar contenido técnico relacionado con sistemas</li>
      <li>Desplegar la web en un servidor</li>
      <li>Conectar un formulario a una base de datos</li>
    </ul>

  </section>

</Layout>

<style>

  .bloque {
    margin-bottom: 2rem;
  }

  h2 {
    margin-bottom: 0.5rem;
  }
  
</style>
---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Página no encontrada">

<main class="contenedor-error">

    <section class="tarjeta-error">

        <span class="etiqueta">Error 404</span>

        <h1>Página no encontrada</h1>

        <p>
            La página que estás intentando visitar no existe o ha sido eliminada.
            Puedes volver al inicio o continuar navegando por el sitio.
        </p>

        <div class="acciones-error">
            <a href="/" class="boton-principal">Volver al inicio</a>
            <a href="/blog" class="boton-principal">Ir al blog</a>
        </div>

    </section>

</main>

</Layout>



<style>



.contenedor-error {

    max-width: 900px;
    min-height: calc(100vh - 190px);
    margin: 0 auto;
    padding: 5rem 2rem;
    display: flex;
    align-items: center;

}


.tarjeta-error {

    width: 100%;
    background: var(--color-tarjeta);
    border: 1px solid var(--color-borde);
    border-radius: 24px;
    padding: 3rem;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);

}

.etiqueta {

    color: var(--color-primario);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.08em;

}

.tarjeta-error h1 {

    margin: 0.8rem 0 1rem;
    font-size: clamp(2rem, 5vw, 3.2rem);
    color: var(--color-texto);

}

.tarjeta-error p {

    color: var(--color-secundario);
    line-height: 1.7;
}

..acciones-error {
        
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}



.boton-principal,
.boton-secundario {

    display: inline-block;
    padding: 0.9rem 1.5rem;
    background: var(--color-primario);
    color: #ffffff;
    border-radius: 12px;
    text-decoration: none;
    font-weight: bold;
    border: 1px solid #93c5fd;
    transition: all 0.25s ease;
}

.boton-principal:hover,
.boton-secundario:hover {

    background: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);
}


/* RESPONSIVE */

@media (max-width: 600px) {

    .acciones-error {
        flex-direction: column;
    }
    
}
</style>
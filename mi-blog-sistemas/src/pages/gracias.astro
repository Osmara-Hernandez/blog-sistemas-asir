---
import Layout from '../layouts/Layout.astro';
---

<Layout titulo="Mensaje enviado">

  <main class="contenedor-gracias">

    <section class="tarjeta-gracias">

      <span class="etiqueta">Mensaje recibido</span>

      <h1>Formulario enviado correctamente</h1>

      <p>
        El mensaje ha sido procesado mediante PHP y almacenado en la base de datos MariaDB.
      </p>

      <div class="resumen-gracias">

        <p><strong>Estado:</strong> Envío completado</p>
        <p><strong>Backend:</strong> PHP</p>
        <p><strong>Base de datos:</strong> MariaDB</p>

      </div>

      <div class="acciones-gracias">

        <a href="/" class="boton-principal">Volver al inicio</a>
        <a href="/contacto" class="boton-secundario">Enviar otro mensaje</a>

      </div>

    </section>

  </main>

</Layout>


<style>

.contenedor-gracias {

  max-width: 900px;
  margin: 0 auto;
  padding: 5rem 2rem;

}

.tarjeta-gracias {

  background: var(--color-tarjeta);
  border: 1px solid var(--color-borde);
  border-radius: 24px;
  padding: 3rem;
  box-shadow: 0 18px 45px rgba(15, 23, 42, 0.06);

}

.etiqueta {

  color: var(--color-primario);
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.08em;

}

.tarjeta-gracias h1 {

  margin: 0.8rem 0 1rem;
  font-size: clamp(2rem, 5vw, 3.2rem);
  color: var(--color-texto);

}

.tarjeta-gracias p {

  color: var(--color-secundario);
  line-height: 1.7;

}

.resumen-gracias {

  margin: 2rem 0;
  padding: 1.5rem;
  background: var(--color-fondo);
  border: 1px solid var(--color-borde);
  border-radius: 16px;

}

.resumen-gracias p {

  margin: 0.4rem 0;

}

.acciones-gracias {

  display: flex;
  gap: 1rem;
  flex-wrap: wrap;

}


.boton-principal,
.boton-secundario {

  display: inline-block;
  padding: 0.9rem 1.5rem;
  background: var(--color-primario);  
  color: #ffffff;
  border-radius: 12px;
  text-decoration: none;
  font-weight: bold;
  border: 1px solid #93c5fd;
  transition: all 0.25s ease;

}


.boton-principal:hover,
.boton-secundario:hover {

  background: #1d4ed8; 
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);

}

/*Responsive*/


@media (max-width: 600px) {

  .tarjeta-gracias {
    padding: 2rem;
    
  }

  .acciones-gracias {

    flex-direction: column;

  }
}
</style>
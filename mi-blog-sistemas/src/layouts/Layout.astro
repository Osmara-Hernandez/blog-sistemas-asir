
---
import '../styles/global.css';
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';


const { titulo = 'Blog de Sistemas' } = Astro.props;
---

<!doctype html>

<html lang="es">

  <head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Proyecto ASIR" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>

  </head>

  <body>

    <Nav />

    <main class="contenido_principal">

      <slot />

    </main>

    <Footer />

    <script is:inline>

      document.addEventListener('DOMContentLoaded', () => {
        const botonModo = document.getElementById('boton_modo');

        if (!botonModo) return;

        const modoGuardado = localStorage.getItem('modo');

        if (modoGuardado === 'oscuro') {
          document.body.classList.add('modo_oscuro');
        }

        botonModo.addEventListener('click', () => {
          document.body.classList.toggle('modo_oscuro');

          if (document.body.classList.contains('modo_oscuro')) {
            localStorage.setItem('modo', 'oscuro');
          } else {
            localStorage.setItem('modo', 'claro');
          }

        });

      });

    </script>

  </body>

</html>

<style>

html,
body {

  margin: 0;
  width: 100%;
  min-height: 100%;
  font-family: Arial, sans-serif;
  background-color: #f1f5f9;
  color: #0f172a;

}
  .contenido_principal {

    max-width: none;
    margin: 0;
    padding: 0;

  }

  body.modo_oscuro {

  background-color: #0f172a;
  color: #e2e8f0;

}

  body.modo_oscuro .tarjeta {

    background: #1e293b;
  border: 1px solid #334155;

  }


  body.modo_oscuro .tarjeta-noticia {

  background: #1e293b;

}

  body.modo_oscuro input,
  body.modo_oscuro textarea {

    background-color: #1e1e1e;
    color: #f1f1f1;
    border: 1px solid #555555;
    
  }
  
</style>